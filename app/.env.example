# Vehicle Service App configuration
# Copy this file to `.env` and adjust the values, or export these variables
# directly in your shell before running the app.

# Base URL of the Vehicle Service API.
# For the local Postman mock server, use its localhost URL, e.g.:
#   VEHICLE_API_BASE_URL=http://localhost:4500
VEHICLE_API_BASE_URL=http://localhost:4500

# API key for authentication. Leave empty when hitting the local mock server.
VEHICLE_API_KEY=
